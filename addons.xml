<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.telugulive" name="Telugu Live" version="1.1.0" provider-name="Telugu Live">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Live Telugu TV channels with Jio OTP Login</summary>
    <description lang="en_GB">Plays a playlist of free-to-air Telugu TV channels with secure Jio authentication.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
  </extension>
</addon>
<addon id="repository.telugulive" name="Telugu Live Repository" version="1.0.0" provider-name="Telugu Live">
  <extension point="xbmc.addon.repository" name="Telugu Live Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/aieditsram-svg/kodi-tv/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/aieditsram-svg/kodi-tv/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/aieditsram-svg/kodi-tv/main/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Telugu Live add-on repository</summary>
    <description lang="en_GB">Hosts the Telugu Live video add-on.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
  </extension>
</addon>
</addons>
